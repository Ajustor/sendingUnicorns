<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 installer for sendingUnicorns.

  Build (from the project root, after a release build: cargo build -r):
    candle.exe -arch x64 -dProductVersion=0.1.0 -out wix\main.wixobj wix\main.wxs
    light.exe  -ext WixUIExtension -out sendingUnicorns-setup.msi wix\main.wixobj

  UpgradeCode is this product's own: never reuse another app's, MajorUpgrade
  would uninstall it.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="sendingUnicorns"
           Language="1036"
           Version="$(var.ProductVersion)"
           Manufacturer="Ajustor"
           UpgradeCode="{3EB7446D-21EB-46FD-BB02-FCA740E12A5F}">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="sendingUnicorns — client HTTP léger" />

    <MajorUpgrade DowngradeErrorMessage="Une version plus récente de sendingUnicorns est déjà installée." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://ajustor.github.io/sendingUnicorns/" />

    <UIRef Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="wix\License.rtf" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="sendingUnicorns" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <Feature Id="ProductFeature" Title="sendingUnicorns" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="MainExecutable" Name="sendingUnicorns.exe"
              Source="target\release\sendingUnicorns.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="StartMenuLink" Name="sendingUnicorns"
                  Description="Client HTTP léger"
                  Target="[INSTALLFOLDER]sendingUnicorns.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\sendingUnicorns" Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>
